# =============================================================================
# Backend - Java / Spring Boot / Gradle
# =============================================================================

# Gradle local cache and build outputs
.gradle/
/backend/.gradle/
/backend/build/

# Java compiler and runtime outputs
/backend/out/
/backend/logs/
/backend/hs_err_pid*
/backend/replay_pid*
*.class
*.hprof
*.pid
*.log

# IntelliJ IDEA
/.idea/
*.iml
*.ipr
*.iws


# =============================================================================
# Frontend - React / TypeScript / Vite / Node.js
# =============================================================================

# Installed dependencies
/frontend/node_modules/

# Production and SSR build outputs
/frontend/dist/
/frontend/dist-ssr/

# Tool caches and generated type-check state
/frontend/.vite/
/frontend/.eslintcache
/frontend/*.tsbuildinfo

# Test and coverage outputs
/frontend/coverage/
/frontend/test-results/
/frontend/playwright-report/

# Package manager and frontend tool logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# =============================================================================
# Local environment and editor settings
# =============================================================================

# Secrets and machine-specific environment values
.env
.env.*
!.env.example
!**/.env.example

# VS Code local settings; share only recommended extensions
/.vscode/*
!/.vscode/extensions.json

# Vim swap files
*.swp
*.swo


# =============================================================================
# Operating system files
# =============================================================================

.DS_Store
Thumbs.db
